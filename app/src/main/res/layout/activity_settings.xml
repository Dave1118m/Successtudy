<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bg_dark">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="System &amp; AI Settings"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- GEMINI AI CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✨ Google Gemini AI Configuration"
                        android:textStyle="bold"
                        android:textColor="@color/teal_primary"
                        android:textSize="15sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Used for automated study note summaries, concept extraction, and smart quiz generation."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gemini API Key"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etGeminiApiKey"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_rounded_card"
                        android:hint="Paste your Gemini Pro API key"
                        android:inputType="textPassword"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gemini Model"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etGeminiModel"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_rounded_card"
                        android:hint="e.g. gemini-flash-latest or gemini-pro-latest"
                        android:text="gemini-flash-latest"
                        android:inputType="text"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btnTestGemini"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Test Gemini AI Connection"
                        android:textColor="@color/teal_primary"
                        android:background="@drawable/btn_secondary_shape"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvGeminiStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SMTP EMAIL SETTINGS CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📧 SMTP Email Settings"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SMTP Host"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etSmtpHost"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_rounded_card"
                        android:hint="e.g. smtp.gmail.com"
                        android:inputType="text"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SMTP Port"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etSmtpPort"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_rounded_card"
                        android:hint="e.g. 587"
                        android:inputType="number"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sender Email"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etSenderEmail"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_rounded_card"
                        android:hint="sender@gmail.com"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="App Password"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etAppPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_rounded_card"
                        android:hint="Enter 16-character app password"
                        android:inputType="textPassword"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Use TLS Encryption"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="13sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/swUseTls"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnTestConnection"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Test SMTP Connection"
                        android:textColor="@color/teal_primary"
                        android:background="@drawable/btn_secondary_shape"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Save Button -->
    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Save All Settings"
        android:textColor="@color/bg_darker"
        android:textStyle="bold"
        android:textSize="16sp"
        android:backgroundTint="@color/teal_primary" />

</LinearLayout>
