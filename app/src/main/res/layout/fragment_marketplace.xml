<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Study Marketplace"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Access and purchase verified notes and quizzes from peers"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <!-- Filters & Search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:weightSum="3"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etMarketSearch"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1.8"
            android:background="@drawable/bg_rounded_card"
            android:hint="Search store..."
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:paddingHorizontal="12dp"
            android:textSize="13sp"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="6dp" />

        <Spinner
            android:id="@+id/spMarketFilterSubject"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1.2"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_rounded_card"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <!-- Content List Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMarketItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp" />

</LinearLayout>
