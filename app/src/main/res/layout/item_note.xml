<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/itemNoteSubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_card"
                android:backgroundTint="@color/bg_dark"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="STUDY MATERIAL"
                android:textColor="@color/teal_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvAiBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ AI Analyzed"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/itemNoteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Material Title"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/itemNoteDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap to read the AI summary and key notes generated from this material."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginTop="6dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <Button
                android:id="@+id/btnReadSummary"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="📖 Read Summary"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/btn_secondary_shape"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnStartQuiz"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🎯 Take Quiz"
                android:textSize="12sp"
                android:textColor="@color/bg_darker"
                android:textStyle="bold"
                android:backgroundTint="@color/teal_primary"
                android:layout_marginStart="6dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
